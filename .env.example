# ==============================================================================
# RoadGuard AI - Environment Configuration
# AI-Powered Road Damage Detection & Smart Maintenance Reporting Platform
# ==============================================================================

# Application Environment (development | staging | production)
ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo Mode (If True, loads realistic simulated data, sample road clips, & safe PWD sandbox)
DEMO_MODE=True

# Database Configuration
# Default: Embedded SQLite for instant zero-dependency execution
# Production: PostgreSQL + PostGIS (e.g. postgresql://user:password@localhost:5432/roadguard_ai)
DATABASE_URL=sqlite:///./roadguard.db

# JWT Authentication
JWT_SECRET=super-secret-roadguard-enterprise-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Model Configuration
AI_MODEL_PATH=./models/road_damage_yolo.pt
AI_CONFIDENCE_THRESHOLD=0.35
AI_IOU_THRESHOLD=0.45
AI_FRAME_SKIP=2
AI_IMAGE_SIZE=640
AI_DEVICE=cpu

# SMS / OTP Verification Service
# Providers: mock (for zero-cost development/hackathon) | twilio | fast2sms
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_SENDER_ID=ROADGUARD
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Government Reporting Integration Layer
# Department: State PWD, Bruhat Bengaluru Mahanagara Palike, Greater Chennai Corp, etc.
GOVERNMENT_DEPARTMENT=Public Works Department (State Highway Division)
GOVERNMENT_API_URL=https://api.pwd.gov.in/v1/grievance
GOVERNMENT_API_KEY=
GOVERNMENT_PORTAL_URL=https://grievance.pwd.gov.in/public
GOVERNMENT_INTEGRATION_MODE=sandbox
GOVERNMENT_FALLBACK_EMAIL=reports@pwd.gov.in

# Mapping Configuration
# Maps work out of the box with Leaflet/OpenStreetMap. Add Google Maps key if preferred:
VITE_GOOGLE_MAPS_API_KEY=

# Google AI Studio / Gemini API (Optional for advanced natural language summaries)
GEMINI_API_KEY=

# Multi-LLM Support (Optional - for enhanced AI explanations)
# Get keys from: https://platform.openai.com, https://console.anthropic.com, or run Ollama locally
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Storage Directory for Captured Evidence & Annotated Frames
STORAGE_PATH=./storage/evidence
MAX_UPLOAD_SIZE_MB=50
